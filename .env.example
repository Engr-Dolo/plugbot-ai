# Local defaults. In production, configure these in the Render dashboard.
NODE_ENV=development
PORT=3000

# mock, openai, or gemini
AI_PROVIDER=mock

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:61328

# OpenAI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Render runs behind one trusted proxy hop. Set 0 for direct hosting.
TRUST_PROXY_HOPS=1

# Provider reliability and graceful deployment shutdown
PROVIDER_MAX_RETRIES=1
PROVIDER_ATTEMPT_TIMEOUT_MS=20000
PROVIDER_TOTAL_DEADLINE_MS=28000
PROVIDER_RETRY_BASE_DELAY_MS=250
SHUTDOWN_TIMEOUT_MS=10000
